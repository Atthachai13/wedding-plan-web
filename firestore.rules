rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // แผนงานแต่ง: ใครที่ล็อกอิน (anonymous ก็ได้) และรู้ลิงก์+รหัสหน้าเว็บ แก้ได้
    match /wedding/{docId} {
      allow read, write: if request.auth != null;
      match /{sub=**} {
        allow read, write: if request.auth != null;
      }
    }
  }
}
